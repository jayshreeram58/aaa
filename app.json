{
  "name": "Course Wallah Downloader Bot",
  "description": "⚡ High-Performance, Multi-Platform Academic Video & PDF Downloader Telegram Bot with Single-Pass Watermarking & Multi-Bot Scalability",
  "keywords": [
    "telegram-bot",
    "video-downloader",
    "course-wallah",
    "academic-parser",
    "pdf-watermark",
    "m3u8-downloader",
    "pyrogram",
    "multi-bot",
    "heroku"
  ],
  "repository": "https://github.com/ramjipatel-tech/course-wallah-downloader-bot",
  "logo": "https://raw.githubusercontent.com/ramjipatel-tech/course-wallah-downloader-bot/main/assets/start/cw_logo.png",
  "success_url": "/",
  "buildpacks": [
    {
      "url": "heroku-community/apt"
    },
    {
      "url": "heroku/python"
    }
  ],
  "env": {
    "API_ID": {
      "description": "Telegram API ID from https://my.telegram.org",
      "value": "",
      "required": true
    },
    "API_HASH": {
      "description": "Telegram API Hash from https://my.telegram.org",
      "value": "",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "Primary Telegram Bot Token from @BotFather",
      "value": "",
      "required": true
    },
    "OWNER_ID": {
      "description": "Your Telegram numeric user ID (e.g. 5432109876)",
      "value": "",
      "required": true
    },
    "GITHUB_TOKEN": {
      "description": "GitHub Personal Access Token (classic with 'repo' scope) to automatically push extracted batches to GitHub",
      "value": "",
      "required": false
    },
    "GITHUB_REPO": {
      "description": "Target GitHub repository (e.g. ramjipatel-tech/course-wallah-platform)",
      "value": "ramjipatel-tech/course-wallah-platform",
      "required": false
    },
    "GITHUB_BRANCH": {
      "description": "Target branch for auto-pushing data",
      "value": "main",
      "required": false
    },
    "ADMINS": {
      "description": "Comma-separated list of admin Telegram IDs (Optional)",
      "value": "",
      "required": false
    },
    "WATERMARK_TEXT": {
      "description": "Watermark label placed on downloaded videos and PDFs",
      "value": "Course Wallah",
      "required": false
    },
    "DOWNLOAD_WORKERS": {
      "description": "Max concurrent download threads (1-4)",
      "value": "4",
      "required": false
    },
    "UPLOAD_WORKERS": {
      "description": "Max concurrent upload threads (1-3)",
      "value": "3",
      "required": false
    }
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "eco"
    }
  }
}
